{
  "name": "@cyc-seattle/clubspot-sdk",
  "version": "0.0.0-development",
  "description": "A community-supported TypeScript SDK for theclubspot.com",
  "author": "CYC Community Sailing Center",
  "license": "Apache-2.0",
  "homepage": "https://github.com/cyc-seattle/clubspot-sdk#readme",
  "bugs": {
    "url": "https://github.com/cyc-seattle/clubspot-sdk/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyc-seattle/clubspot-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.7",
  "prettier": "@cyc-seattle/ts-config/prettier",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fake": {
      "types": "./dist/fake/index.d.ts",
      "default": "./dist/fake/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "clubspot": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^13.1.0",
    "@cyc-seattle/commodore": "^0.1.0",
    "commander": "^13.1.0",
    "parse": "^5.3.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^8.0.0",
    "@cyc-seattle/ts-config": "^0.1.2",
    "@types/node": "^22.20.5",
    "@types/parse": "^3.0.9",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~7.0.0",
    "vitest": "^5.0.4"
  }
}
